local function SaveSettings()
    LocalPlayer:SetAttribute("AutoCollect", autoCollect)
    LocalPlayer:SetAttribute("AutoSubmit", autoSubmit)
    LocalPlayer:SetAttribute("SubmitSpeed", submitSpeed)
end

local function LoadSettings()
    autoCollect = LocalPlayer:GetAttribute("AutoCollect") or false
    autoSubmit = LocalPlayer:GetAttribute("AutoSubmit") or false
    submitSpeed = LocalPlayer:GetAttribute("SubmitSpeed") or 1
end

local function SafeFirePrompt(prompt)
    pcall(function()
        fireproximityprompt(prompt)
    end)
end

local function findPrompts(namePattern)
    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.ObjectText:lower():find(namePattern) then
            table.insert(found, obj)
        end
    end
    return found
end

local function isSummer()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SurfaceGui") or obj:IsA("TextLabel") then
            if tostring(obj.Text):lower():find("summer harvest") then
                return true
            end
        end
    end
    return false
end

local function collectPlants()
    while autoCollect and task.wait(0.1) do
        if not isSummer() then continue end
        for _, prompt in ipairs(findPrompts("collect")) do
            if not autoCollect then break end
            SafeFirePrompt(prompt)
            task.wait(0.05)
        end
    end
end

local function submitPlants()
    while autoSubmit and task.wait(submitSpeed) do
        for _, prompt in ipairs(findPrompts("submit")) do
            if not autoSubmit then break end
            SafeFirePrompt(prompt)
        end
    end
end

local function updateUI()
    AutoCollectButton.Text = "Auto Collect: " .. (autoCollect and "ON" or "OFF")
    AutoCollectButton.BackgroundColor3 = autoCollect and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60)
    AutoSubmitButton.Text = "Auto Submit: " .. (autoSubmit and "ON" or "OFF")
    AutoSubmitButton.BackgroundColor3 = autoSubmit and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(60, 60, 60)
    SpeedLabel.Text = "Submit Speed: " .. string.format("%.2f", submitSpeed)
    SpeedValue.Text = tostring(submitSpeed)
end

LoadSettings()
updateUI()

if autoCollect then collectionLoop = task.spawn(collectPlants) end
if autoSubmit then submissionLoop = task.spawn(submitPlants) end

CloseButton.MouseButton1Click:Connect(function()
    Frame.Visible = false
    uiOpen = false
end)

ToggleButton.MouseButton1Click:Connect(function()
    uiOpen = not uiOpen
    Frame.Visible = uiOpen
end)

AutoCollectButton.MouseButton1Click:Connect(function()
    autoCollect = not autoCollect
    SaveSettings()
    updateUI()
    if autoCollect then
        if collectionLoop then task.cancel(collectionLoop) end
        collectionLoop = task.spawn(collectPlants)
    elseif collectionLoop then
        task.cancel(collectionLoop)
        collectionLoop = nil
    end
end)

AutoSubmitButton.MouseButton1Click:Connect(function()
    autoSubmit = not autoSubmit
    SaveSettings()
    updateUI()
    if autoSubmit then
        if submissionLoop then task.cancel(submissionLoop) end
        submissionLoop = task.spawn(submitPlants)
    elseif submissionLoop then
        task.cancel(submissionLoop)
        submissionLoop = nil
    end
end)

SpeedValue:GetPropertyChangedSignal("Text"):Connect(function()
    local clean = SpeedValue.Text:gsub("[^%d%.]", "")
    if SpeedValue.Text ~= clean then
        SpeedValue.Text = clean
    end
end)

SpeedValue.FocusLost:Connect(function()
    local val = tonumber(SpeedValue.Text)
    if val and val >= 0.05 and val <= 10 then
        submitSpeed = val
        SaveSettings()
        updateUI()
    else
        SpeedValue.Text = tostring(submitSpeed)
    end
end)
